rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId} and subcollections
// Document ID: userId (matches auth.uid)
// Subcollections:
//   - data/resume: User resume text, target job description, settings, and ATS score
//   - data/settings: User home location and work preferences
// Access:
//   - Read/Write: Strictly owner-only (request.auth.uid == userId).
//
// Collection: ai-cache/{cacheKey}
// Document ID: SHA-256 hex string (64 characters) of the AI prompt
// Fields:
//   - cacheKey: string (required, 64-char hex SHA-256, matches doc ID, immutable on update)
//   - response: string (required, 1 to 200,000 characters) - Cleaned AI JSON response
//   - createdAt: timestamp (required, recent server timestamp)
// Access:
//   - Get: Allowed for authenticated users and valid SHA-256 cache key lookups.
//   - List: Denied (prevents collection enumeration and bulk scraping).
//   - Create / Update: Allowed with strict schema validation (for authenticated users
//     and serverless API routes running with Firebase Web Client SDK).
//   - Delete: Denied.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate 64-character SHA-256 hex cache key format
    function isValidCacheKey(key) {
      return key is string &&
             key.size() == 64 &&
             key.matches('^[a-fA-F0-9]{64}$');
    }

    // Domain validator for ai-cache entries (used in BOTH create and update)
    function isValidCacheEntry(cacheKey) {
      return request.resource.data.keys().hasOnly(['cacheKey', 'response', 'createdAt']) &&
             request.resource.data.keys().hasAll(['cacheKey', 'response', 'createdAt']) &&
             request.resource.data.cacheKey == cacheKey &&
             isValidCacheKey(request.resource.data.cacheKey) &&
             request.resource.data.response is string &&
             request.resource.data.response.size() > 0 &&
             request.resource.data.response.size() <= 200000 &&
             request.resource.data.createdAt is timestamp &&
             request.resource.data.createdAt <= request.time + duration.value(1, 'm') &&
             request.resource.data.createdAt >= request.time - duration.value(5, 'm');
    }

    // ===============================================================
    // Collection: users
    // ===============================================================
    // Users can only read and write to their own user profile and subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // Collection: ai-cache
    // ===============================================================
    // AI Cache stores cached LLM analysis and resume responses keyed
    // by SHA-256 hash of the input prompt.
    //
    // Access Controls:
    // - get: Allowed for valid 64-char SHA-256 cache key lookups.
    // - list: Explicitly DENIED to prevent enumerating or bulk-scraping cached resumes.
    // - create: Allowed for valid cache entries matching strict schema & size bounds.
    // - update: Allowed for valid cache entries with immutable cacheKey.
    // - delete: Explicitly DENIED.
    match /ai-cache/{cacheKey} {
      allow get: if isValidCacheKey(cacheKey);
      allow list: if false;

      allow create: if isValidCacheKey(cacheKey) &&
                       isValidCacheEntry(cacheKey);

      allow update: if isValidCacheKey(cacheKey) &&
                       isValidCacheEntry(cacheKey) &&
                       request.resource.data.cacheKey == resource.data.cacheKey;

      allow delete: if false;
    }

    // ===============================================================
    // Default Deny
    // ===============================================================
    // Deny all other collections and documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
